# 手元用の秘密の値の名前の一覧。値は書かない。
# cp .dev.vars.example .dev.vars として、.dev.vars に値を書く（.dev.vars は git の管理から外してある）
# 手順: .claude/skills/setup-secrets/SKILL.md
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CREATE_FAMILY_TOKEN=
# 運営の記録の画面（/ops/record）の鍵。32 文字以上のランダムな値で、CREATE_FAMILY_TOKEN とは別の値にする（0030）
OPS_RECORD_TOKEN=
# 運営が記録を見てよい、デモでない家族の ID（カンマ区切り）。親の同意を得た家族だけ。手元では空のままでよい（0030）
OPS_RECORD_FAMILIES=
# デモの初期化（/start の「デモを最初の状態に戻す」）の鍵。32 文字以上のランダムな値で、ほかの鍵とは別の値にする（0038）
DEMO_RESET_TOKEN=
# 審査員の案内（/demo/<鍵>）の鍵。32 文字以上の URL に載る値（openssl rand -hex 16 で 32 文字）で、ほかの鍵とは別の値にする。本番には登録しない（0062）
DEMO_GUIDE_KEY=
# 審査員の案内に並べる 4 人のリンクの合言葉。JSON で {"じいちゃん":"...","お母さん":"...","まさとおじさん":"...","ゆい":"..."}（/join/ より後ろの文字列）（0062）
DEMO_GUIDE_LINKS=
# 秘密ではない。手元では本番の設定（APP_ENV=production）を上書きし、どの家族でもデモの時計を進められるようにする
APP_ENV=development
