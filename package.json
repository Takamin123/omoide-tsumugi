{
  "name": "omoide-tsumugi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:preview": "CLOUDFLARE_ENV=preview vite build",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "deploy:production": "vite build && node scripts/assert-build-env.mjs production && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview vite build && node scripts/assert-build-env.mjs preview && wrangler deploy",
    "typecheck": "npm run cf-typegen && tsc -b",
    "test": "vitest run",
    "eval:clean": "vitest run --config vitest.evals.config.ts evals/clean-transcript.eval.ts",
    "eval:entrance": "vitest run --config vitest.evals.config.ts evals/entrance.eval.ts",
    "eval:records": "vitest run --config vitest.evals.config.ts evals/records.eval.ts",
    "eval:demo-seed": "vitest run --config vitest.evals.config.ts evals/demo-seed-clean.eval.ts",
    "cf-typegen": "wrangler types src/server/platform/cloudflare/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "postinstall": "npm run cf-typegen"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
